# 复制为 .env 并填入你的 key；server 启动即用真实 LLM
AGENT_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的key
OPENAI_MODEL=deepseek-chat

# pi provider（可选，AGENT_PROVIDER=pi 启用）：走本机 pi CLI（pi.dev）
# PI_MODEL=claude-sonnet:high    # 不设则用 pi 自身默认模型
# PI_CWD=/path/to/workspace      # pi 加载上下文的目录（默认 server/）
