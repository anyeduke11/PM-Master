# 复制为 .env 并填入你的 key；server 启动即用真实 LLM（不配置则以 mock provider 全功能运行）
AGENT_PROVIDER=openai            # mock | openai（任意 OpenAI 兼容端点）| pi
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-你的key
OPENAI_MODEL=gpt-4o              # 强模型池：教练/周报/评定
OPENAI_MODEL_FAST=gpt-4o-mini    # 快模型池：出题/判分（可选；RPM 宽松池，429 分池退避）
OPENAI_MAX_TOKENS=6000           # 推理模型思考耗 token，预算放大

# pi provider（可选，AGENT_PROVIDER=pi 启用）：走本机 pi CLI（pi.dev）
# PI_MODEL=claude-sonnet:high    # 不设则用 pi 自身默认模型
# PI_CWD=/path/to/workspace      # pi 加载上下文的目录（默认 server/）
